/* ICS */
function icsEvent(uid,title,startZ,endZ,loc){
  const f=s=>s.replace(/[-:]/g,'').replace('.000','');
  return['BEGIN:VEVENT','UID:'+uid+'@travl','DTSTAMP:'+f(new Date().toISOString()).slice(0,15)+'Z','DTSTART:'+startZ,'DTEND:'+endZ,'SUMMARY:'+title,'LOCATION:'+loc,'END:VEVENT'].join('\r\n');
}
const EV={
 ua8932:['UA 8932 SAN→MUC (Lufthansa)','20260818T001500Z','20260818T112500Z','San Diego Intl'],
 lh1916:['LH 1916 MUC→PMO','20260818T132000Z','20260818T152000Z','Munich Airport'],
 hertz1:['Hertz pickup PMO · L662E040086','20260818T163000Z','20260818T170000Z','Palermo Airport'],
 kindred:['Kindred check-in Trapani','20260818T140000Z','20260818T150000Z','Via Spalti 33 Trapani'],
 lx1741:['LX 1741 PMO→ZRH · ACWOBL/YJPCZI','20260822T074500Z','20260822T094500Z','Palermo Airport'],
 europcar:['Europcar pickup ZRH · 746398455','20260822T103000Z','20260822T110000Z','Zurich Airport'],
 resort:['Portes du Soleil check-in · A1900002356418001','20260822T140000Z','20260822T150000Z','Route de Champoussin 22'],
 ua8391:['UA 8391 GVA→YUL (Air Canada)','20260829T104000Z','20260829T184000Z','Geneva Airport'],
 ua8607:['UA 8607 YUL→SAN (Air Canada)','20260829T214500Z','20260830T033900Z','Montreal YUL']
};
function downloadICS(key){
  const evs=key==='ALL'?Object.entries(EV).map(([k,v])=>icsEvent(k,...v)):[icsEvent(key,...EV[key])];
  const cal=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//travl//EN',...evs,'END:VCALENDAR'].join('\r\n');
  const b=new Blob([cal],{type:'text/calendar'});const a=document.createElement('a');
  a.href=URL.createObjectURL(b);a.download=key==='ALL'?'travl-full-trip.ics':`travl-${key}.ics`;a.click();URL.revokeObjectURL(a.href);
}
document.addEventListener('click',e=>{const b=e.target.closest('[data-ics]');if(b)downloadICS(b.dataset.ics);});

/* CHECKLISTS */
function lists(){
  document.querySelectorAll('ul.check').forEach(ul=>{
    const store=ul.dataset.store;
    ul.querySelectorAll('.box').forEach((b,i)=>{
      if(localStorage.getItem(store+i)==='1'){b.setAttribute('aria-checked','true');b.textContent='✓';b.nextElementSibling.innerHTML='<s>'+b.nextElementSibling.innerHTML+'</s>';}
      const toggle=()=>{
        const on=b.getAttribute('aria-checked')!=='true';
        b.setAttribute('aria-checked',on?'true':'false');b.textContent=on?'✓':'';
        const t=b.nextElementSibling;
        t.innerHTML=on?'<s>'+t.innerHTML+'</s>':t.innerHTML.replace(/^<s>|<\/s>$/g,'');
        localStorage.setItem(store+i,on?'1':'0');
      };
      b.addEventListener('click',toggle);
      b.addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter'){e.preventDefault();toggle();}});
    });
  });
}

/*STATUS*/
/* LIVE FLIGHT STATUS via /api/flights (AeroDataBox behind Vercel env key) */
const DEPS={UA8932:'2026-08-18T00:15:00Z',LH1916:'2026-08-18T13:20:00Z',LX1741:'2026-08-22T07:45:00Z',UA8391:'2026-08-29T10:40:00Z',UA8607:'2026-08-29T21:45:00Z'};
async function loadStatus(el,force){
  const f=el.dataset.f,d=el.dataset.d,dep=Date.parse(DEPS[f]);
  const inWindow=Date.now()>dep-48*3600e3&&Date.now()<dep+24*3600e3;
  if(!inWindow&&!force){el.textContent=f+' · status opens T-48h';return;}
  el.textContent=f+' · checking…';
  try{
    const r=await fetch(`/api/flights?flight=${f}&date=${d}`);
    if(r.status===501){el.textContent=f+' · status offline (no key)';return;}
    if(!r.ok)throw 0;
    const j=await r.json();
    const st=(j.status||'scheduled').toUpperCase();
    const gate=j.dep.gate?' · GATE '+j.dep.gate:'';
    const term=j.dep.terminal?' · T'+j.dep.terminal:'';
    const rev=j.dep.rev&&j.dep.rev!==j.dep.sched?' · NEW '+j.dep.rev.slice(11,16):'';
    el.textContent=`${f} · ${st}${term}${gate}${rev}`;
    el.classList.remove('ok','warn');
    el.classList.add(/DELAY|CANCEL|DIVERT/i.test(st)||rev?'warn':'ok');
  }catch(e){el.textContent=f+' · status unavailable';}
}
function statusBoot(){
  document.querySelectorAll('.fstat').forEach(el=>{
    loadStatus(el,false);
    el.addEventListener('click',()=>loadStatus(el,true));
  });
  setInterval(()=>document.querySelectorAll('.fstat').forEach(el=>loadStatus(el,false)),10*60*1000);
}

let booted=false;
function boot(){
  if(booted)return;booted=true;
  tick();setInterval(tick,1000);
  renderToday();setInterval(renderToday,60000);
  wx(38.02,12.54,'Europe/Rome',wxTP,sunTP);
  wx(46.20,6.87,'Europe/Zurich',wxCH,sunCH);
  wx(32.72,-117.16,'America/Los_Angeles',wxSD,sunSD);
  fx();
  buildMap();
  statusBoot();
}
if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(()=>{});
</script>
