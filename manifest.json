<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#14170F">
<title>travl · SICILIA→VALAIS · OPS AUG 2026</title>
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{
  --bg:#14170F; --panel:#1B2015; --panel2:#222919; --line:#39402C; --line2:#4A5238;
  --bone:#E9E4D4; --muted:#9BA285; --dim:#6E755C;
  --olive:#7C8B5D; --sand:#C9A86B; --sand-deep:#A8863F; --blaze:#E8622C;
  --sea:#4FA9A0; --sea-deep:#2E7A73; --alp:#8FB0C4; --alp-deep:#5D82A0; --pine:#5F7350;
  --r:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
body{
  font-family:'Barlow',system-ui,sans-serif;background:var(--bg);color:var(--bone);
  line-height:1.5;font-size:16px;
  background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(233,228,212,.025) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(233,228,212,.025) 40px);
}
.mono{font-family:'JetBrains Mono',monospace}
h1,h2,h3,.disp,summary.chead{font-family:'Big Shoulders Display','Barlow',sans-serif;text-transform:uppercase;letter-spacing:.04em}

/* GATE */
#gate{position:fixed;inset:0;z-index:90;background:linear-gradient(150deg,#0E1310,#1B2015 55%,#20170F);display:flex;align-items:center;justify-content:center;padding:24px}
.stub{background:var(--panel2);border:1px solid var(--line2);width:100%;max-width:410px;border-radius:14px;padding:34px 30px 28px;position:relative;box-shadow:0 24px 60px rgba(0,0,0,.6)}
.stub::before,.stub::after{content:"";position:absolute;width:26px;height:26px;border-radius:50%;background:#14170F;border:1px solid var(--line2);top:56%}
.stub::before{left:-13px}.stub::after{right:-13px}
.stub .route{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:4px}
.stub .code{font-family:'Big Shoulders Display';font-weight:800;font-size:2.1rem;color:var(--bone)}
.stub .arrow{color:var(--blaze);font-size:1.2rem}
.stub .meta{font-family:'JetBrains Mono';font-size:.66rem;text-transform:uppercase;letter-spacing:.18em;color:var(--muted);margin-bottom:22px}
.stub .dashed{border-top:2px dashed var(--line2);margin:20px -30px}
.stub label{display:block;font-family:'JetBrains Mono';font-size:.66rem;text-transform:uppercase;letter-spacing:.18em;color:var(--muted);margin:12px 0 8px}
.stub input{width:100%;font-family:'JetBrains Mono';font-size:1.05rem;padding:12px 14px;border:1px solid var(--line2);border-radius:8px;background:#101408;color:var(--bone);letter-spacing:.1em}
.stub input:focus{outline:2px solid var(--sand);border-color:var(--sand)}
.stub button{width:100%;margin-top:14px;padding:13px;border:0;border-radius:8px;background:var(--sand);color:#14170F;font-family:'Big Shoulders Display';font-size:1.15rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
.stub button:hover{background:var(--sand-deep)}
.stub button:focus-visible{outline:3px solid var(--blaze);outline-offset:2px}
.stub .err{color:var(--blaze);font-size:.85rem;margin-top:10px;min-height:1.2em}

#app{display:none}

/* NAV */
nav{position:sticky;top:0;z-index:40;background:rgba(20,23,15,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;gap:4px;overflow-x:auto;padding:10px 14px}
nav a{flex:0 0 auto;font-family:'JetBrains Mono';font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;text-decoration:none;color:var(--muted);padding:6px 12px;border-radius:6px;border:1px solid transparent}
nav a:hover{border-color:var(--line2);color:var(--bone)}

/* HERO */
header.hero{padding:44px 20px 36px;text-align:center;border-bottom:1px solid var(--line)}
.hero .eyebrow{font-family:'JetBrains Mono';font-size:.66rem;text-transform:uppercase;letter-spacing:.3em;color:var(--sand)}
.hero h1{font-size:clamp(2.6rem,9vw,4.2rem);font-weight:800;line-height:.95;margin:10px 0 6px}
.hero h1 .sic{color:var(--sea)}.hero h1 .swi{color:var(--alp)}.hero h1 .x{color:var(--blaze)}
.hero .dates{font-family:'JetBrains Mono';font-size:.8rem;color:var(--muted);letter-spacing:.12em}
.cd-wrap{max-width:620px;margin:26px auto 0;padding:0 12px}
.cd-label{font-family:'JetBrains Mono';font-size:.68rem;text-transform:uppercase;letter-spacing:.2em;color:var(--muted);margin-bottom:10px}
.cd{display:flex;gap:8px;justify-content:center}
.cd .cell{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:12px 0;flex:1;max-width:104px}
.cd .num{font-family:'JetBrains Mono';font-weight:700;font-size:clamp(1.4rem,6vw,2.1rem);line-height:1;color:var(--sand);font-variant-numeric:tabular-nums}
.cd .unit{font-family:'JetBrains Mono';font-size:.58rem;text-transform:uppercase;letter-spacing:.16em;color:var(--dim);margin-top:6px}
#cdDone{display:none;font-family:'Big Shoulders Display';font-size:1.5rem;color:var(--olive);font-weight:700}
.prog{max-width:620px;margin:22px auto 0;padding:0 12px}
.prog .bar{height:7px;border-radius:99px;background:var(--line);overflow:hidden}
.prog .fill{height:100%;width:0;background:linear-gradient(90deg,var(--sea),var(--blaze) 50%,var(--alp));transition:width .8s}
.prog .lbl{display:flex;justify-content:space-between;font-family:'JetBrains Mono';font-size:.58rem;text-transform:uppercase;letter-spacing:.1em;color:var(--dim);margin-top:6px}
.live{max-width:760px;margin:26px auto 0;padding:0 12px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.chip{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:11px 12px;text-align:center}
.chip .place{font-family:'JetBrains Mono';font-size:.6rem;text-transform:uppercase;letter-spacing:.16em;color:var(--dim)}
.chip .clock{font-family:'JetBrains Mono';font-weight:700;font-size:1.1rem;font-variant-numeric:tabular-nums;margin-top:2px;color:var(--bone)}
.chip .wx{font-size:.8rem;margin-top:3px;color:var(--muted);min-height:1.2em}
.chip .wx .hi{color:var(--sand);font-weight:600}
.chip .sun{font-family:'JetBrains Mono';font-size:.62rem;color:var(--dim);margin-top:2px}
@media(max-width:560px){.live{grid-template-columns:1fr}.chip{display:grid;grid-template-columns:auto auto 1fr;gap:2px 12px;text-align:left;align-items:baseline}.chip .sun{grid-column:3;text-align:right}}

main{max-width:780px;margin:0 auto;padding:8px 16px 90px}

/* TODAY */
#todayCard{margin-top:24px;background:linear-gradient(140deg,var(--panel2),var(--panel));border:1px solid var(--sand-deep);border-radius:var(--r);padding:18px}
#todayCard .tlabel{font-family:'JetBrains Mono';font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--blaze)}
#todayCard h2{font-size:1.6rem;margin:4px 0 8px;color:var(--sand)}
#todayCard .row{display:flex;gap:14px;padding:7px 0;border-bottom:1px dashed var(--line);align-items:baseline}
#todayCard .row:last-child{border-bottom:0}
#todayCard .row .t{font-family:'JetBrains Mono';font-size:.82rem;font-weight:700;color:var(--bone);white-space:nowrap;min-width:74px}
#todayCard .row .d{font-size:.92rem;color:var(--muted)}
#todayCard .row.hot .t,#todayCard .row.hot .d{color:var(--sand)}

/* SECTIONS */
.chapter{margin-top:22px}
details.acc{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
details.acc+details.acc{margin-top:12px}
summary.chead{list-style:none;cursor:pointer;display:flex;align-items:center;gap:12px;padding:15px 16px;font-size:1.3rem;font-weight:700;user-select:none;color:var(--bone)}
summary.chead::-webkit-details-marker{display:none}
summary.chead .tag{font-family:'JetBrains Mono';font-size:.6rem;font-weight:700;letter-spacing:.1em;padding:3px 9px;border-radius:4px;color:#14170F}
.sic-t{background:var(--sea)}.swi-t{background:var(--alp)}.swap-t{background:var(--blaze)}.ops-t{background:var(--sand)}
summary.chead .chev{margin-left:auto;transition:transform .25s;color:var(--dim);font-size:.8rem}
details[open]>summary .chev{transform:rotate(180deg)}
summary.chead .now-pill{font-family:'JetBrains Mono';font-size:.56rem;background:var(--olive);color:#14170F;padding:2px 8px;border-radius:4px;letter-spacing:.1em}
.acc-body{padding:4px 16px 16px;border-top:1px dashed var(--line)}
.leg{display:flex;gap:13px;align-items:baseline;padding:8px 0;border-bottom:1px dashed var(--line)}
.leg:last-of-type{border-bottom:0}
.leg .t{font-family:'JetBrains Mono';font-size:.8rem;white-space:nowrap;font-weight:700;color:var(--bone)}
.leg .d{font-size:.9rem;color:var(--muted)}
.leg .d b{color:var(--bone);font-weight:600}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:.88rem;margin:10px 0}
.kv dt{font-family:'JetBrains Mono';color:var(--dim);font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;padding-top:3px}
.kv dd{color:var(--muted)}.kv dd b{color:var(--bone)}
.conf{display:inline-block;font-family:'JetBrains Mono';font-weight:700;font-size:.78rem;background:var(--sand);color:#14170F;border-radius:4px;padding:1px 7px;letter-spacing:.05em}
.note{margin-top:11px;padding:10px 13px;border-radius:8px;font-size:.85rem;background:rgba(143,176,196,.08);border:1px solid rgba(143,176,196,.25);color:var(--muted)}
.note.warn{background:rgba(232,98,44,.08);border-color:rgba(232,98,44,.4)}
.note b{color:var(--bone)}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.btns a,.btns button{font-family:'JetBrains Mono';font-size:.68rem;letter-spacing:.06em;text-decoration:none;color:var(--sand);border:1px solid var(--sand-deep);background:transparent;border-radius:6px;padding:6px 11px;cursor:pointer}
.btns a:hover,.btns button:hover{background:var(--sand);color:#14170F}
.btns.cool a,.btns.cool button{color:var(--alp);border-color:var(--alp-deep)}
.btns.cool a:hover,.btns.cool button:hover{background:var(--alp);color:#14170F}
.fstat{font-family:'JetBrains Mono';font-size:.68rem;letter-spacing:.05em;padding:6px 11px;border-radius:6px;border:1px dashed var(--line2);color:var(--muted);cursor:pointer}
.fstat.ok{border-color:var(--olive);color:var(--olive)}
.fstat.warn{border-color:var(--blaze);color:var(--blaze)}

/* MAP */
#map{height:420px;border-radius:var(--r);border:1px solid var(--line2);margin-top:4px;filter:saturate(.85) contrast(1.02)}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--panel2);color:var(--bone);border:1px solid var(--line2)}
.leaflet-popup-content{font-family:'Barlow';font-size:.85rem}
.leaflet-popup-content b{font-family:'Big Shoulders Display';font-size:1rem;letter-spacing:.04em;text-transform:uppercase}
.mapkey{display:flex;gap:14px;flex-wrap:wrap;margin:10px 2px 0;font-family:'JetBrains Mono';font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
.mapkey i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}

/* CHECK LISTS */
.check{list-style:none;display:flex;flex-direction:column;gap:9px;padding:12px 16px 16px}
.check li{display:flex;gap:11px;align-items:flex-start;font-size:.9rem;color:var(--muted)}
.check .box{flex:0 0 auto;width:18px;height:18px;border-radius:4px;border:2px solid var(--sand-deep);margin-top:2px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;background:transparent;font-size:.7rem;color:#14170F;user-select:none}
.check .box[aria-checked="true"]{background:var(--olive);border-color:var(--olive)}
.check .box:focus-visible{outline:3px solid var(--blaze);outline-offset:2px}
.check li s{color:var(--dim)}
.subhead{font-family:'JetBrains Mono';font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--sand);padding:12px 16px 0}
footer{text-align:center;padding:30px 20px 44px;color:var(--dim);font-size:.75rem;border-top:1px solid var(--line);margin-top:56px}
</style>
</head>
<body>

<div id="gate" role="dialog" aria-label="Enter passcode">
  <form class="stub" id="gateForm">
    <div class="route"><span class="code">SAN</span><span class="arrow">▸</span><span class="code" style="color:var(--sea)">PMO</span><span class="arrow">▸</span><span class="code" style="color:var(--alp)">GVA</span></div>
    <div class="meta">OP WINDOW 17–29 AUG 2026 · HOLT + DOECKEL</div>
    <div class="dashed" aria-hidden="true"></div>
    <label for="pw">Access code</label>
    <input id="pw" type="password" autocomplete="off" placeholder="•••••••••" aria-describedby="gateErr">
    <button type="submit">Authenticate</button>
    <div class="err" id="gateErr" aria-live="polite"></div>
  </form>
</div>

<div id="app">
<nav>
  <a href="#today">Today</a><a href="#out">Outbound</a><a href="#sicily">Sicily</a><a href="#swap">Swap</a><a href="#swiss">Valais</a><a href="#home">Return</a><a href="#mapsec">Map</a><a href="#docs">Docs</a><a href="#todo">Lists</a>
</nav>

<header class="hero">
  <div class="eyebrow">travl.holtanalytics.org</div>
  <h1><span class="sic">Sicilia</span><span class="x">▸</span><span class="swi">Valais</span></h1>
  <div class="dates">17—29 AUG 2026 · 12 NIGHTS · 2 COUNTRIES · 2 PAX</div>
  <div class="cd-wrap">
    <div class="cd-label" id="cdLabel">T-MINUS TO WHEELS UP</div>
    <div class="cd" id="cd">
      <div class="cell"><div class="num" id="cdD">--</div><div class="unit">days</div></div>
      <div class="cell"><div class="num" id="cdH">--</div><div class="unit">hrs</div></div>
      <div class="cell"><div class="num" id="cdM">--</div><div class="unit">min</div></div>
      <div class="cell"><div class="num" id="cdS">--</div><div class="unit">sec</div></div>
    </div>
    <div id="cdDone">Mission complete. Welcome home.</div>
  </div>
  <div class="prog">
    <div class="bar"><div class="fill" id="progFill"></div></div>
    <div class="lbl"><span>SAN</span><span>Sicily</span><span>Swap</span><span>Valais</span><span>Home</span></div>
  </div>
  <div class="live">
    <div class="chip"><div class="place">San Diego</div><div class="clock" id="clkSD">--:--</div><div class="wx" id="wxSD">…</div><div class="sun" id="sunSD"></div></div>
    <div class="chip"><div class="place">Trapani</div><div class="clock" id="clkTP">--:--</div><div class="wx" id="wxTP">…</div><div class="sun" id="sunTP"></div></div>
    <div class="chip"><div class="place">Champoussin</div><div class="clock" id="clkCH">--:--</div><div class="wx" id="wxCH">…</div><div class="sun" id="sunCH"></div></div>
  </div>
</header>

<main>

<section id="today"><div id="todayCard" hidden>
  <div class="tlabel">CURRENT OP · LIVE</div>
  <h2 id="todayTitle"></h2>
  <div id="todayRows"></div>
</div></section>

<section class="chapter" id="out">
<details class="acc" open data-phase="0">
  <summary class="chead"><span class="tag sic-t">AUG 17–18</span> Insertion <span class="now-pill" hidden>NOW</span><span class="chev">▼</span></summary>
  <div class="acc-body">
    <div class="leg"><span class="t">17:15</span><span class="d"><b>UA 8932</b> SAN ▸ MUC · Lufthansa A350 · 11h10 · seats 29C (K) / 29D (W)</span></div>
    <div class="leg"><span class="t">13:25 +1</span><span class="d">Land Munich · connection 1h55</span></div>
    <div class="leg"><span class="t">15:20</span><span class="d"><b>LH 1916</b> MUC ▸ PMO · A321neo · 2h · seats unassigned</span></div>
    <div class="leg"><span class="t">17:20</span><span class="d">Land Palermo</span></div>
    <div class="leg"><span class="t">18:30</span><span class="d"><b>Hertz pickup</b> PMO · <span class="conf">L662E040086</span> · Jeep Avenger class · $312.42</span></div>
    <div class="leg"><span class="t">~19:30</span><span class="d">Arrive Trapani base</span></div>
    <dl class="kv"><dt>United ref</dt><dd><span class="conf">AR526H</span> K · <span class="conf">ASGTLJ</span> W</dd></dl>
    <p class="note warn"><b>Counter kit:</b> physical Amex (Keegan) · US license · <b>AAA IDP — legally required in Italy.</b></p>
    <div class="btns">
      <a href="https://www.flightaware.com/live/flight/UAL8932" target="_blank" rel="noopener">UA8932 STATUS</a>
      <a href="https://www.flightaware.com/live/flight/DLH1916" target="_blank" rel="noopener">LH1916 STATUS</a>
      <button data-ics="ua8932">+ CAL UA8932</button>
      <span class="fstat" data-f="UA8932" data-d="2026-08-17" title="tap to refresh">UA8932 · standby</span>
      <button data-ics="lh1916">+ CAL LH1916</button>
      <span class="fstat" data-f="LH1916" data-d="2026-08-18" title="tap to refresh">LH1916 · standby</span>
      <button data-ics="hertz1">+ CAL HERTZ</button>
    </div>
  </div>
</details>
</section>

<section class="chapter" id="sicily">
<details class="acc" data-phase="1">
  <summary class="chead"><span class="tag sic-t">AUG 18–22</span> Sector 1 · Trapani <span class="now-pill" hidden>NOW</span><span class="chev">▼</span></summary>
  <div class="acc-body">
    <dl class="kv">
      <dt>Base</dt><dd><b>Kindred swap · John Francis's place</b> · 4 nights</dd>
      <dt>Grid</dt><dd>Via Spalti 33, 4th floor · 91100 Trapani</dd>
      <dt>Window</dt><dd>In Tue 18 · 16:00 → Out Sat 22 · 11:00</dd>
      <dt>Comms</dt><dd>Kindred Concierge + John Francis (in-app)</dd>
    </dl>
    <div class="leg"><span class="t">40 min</span><span class="d"><b>San Vito Lo Capo</b> — sport routes over turquoise water; DWS sectors on the headland</span></div>
    <div class="leg"><span class="t">50 min</span><span class="d"><b>Zingaro reserve</b> — deep-water solo + swim coves</span></div>
    <div class="leg"><span class="t">10 min</span><span class="d"><b>Erice</b> — cable car, medieval streets, Maria Grammatico pastries</span></div>
    <div class="leg"><span class="t">15 min</span><span class="d"><b>Salt pans</b> — sunset watch, windmills</span></div>
    <div class="btns"><button data-ics="kindred">+ CAL CHECK-IN</button></div>
  </div>
</details>
</section>

<section class="chapter" id="swap">
<details class="acc" data-phase="2">
  <summary class="chead"><span class="tag swap-t">SAT AUG 22</span> Swap day <span class="now-pill" hidden>NOW</span><span class="chev">▼</span></summary>
  <div class="acc-body">
    <div class="leg"><span class="t">06:15</span><span class="d">Depart base — packed the night prior</span></div>
    <div class="leg"><span class="t">07:30</span><span class="d">Hertz return PMO (desk opens 07:30)</span></div>
    <div class="leg"><span class="t">09:45</span><span class="d"><b>LX 1741</b> PMO ▸ ZRH · <span class="conf">ACWOBL</span> K · <span class="conf">YJPCZI</span> W · Air Baltic A220</span></div>
    <div class="leg"><span class="t">11:45</span><span class="d">Land Zurich</span></div>
    <div class="leg"><span class="t">12:30</span><span class="d"><b>Europcar pickup</b> ZRH · <span class="conf">746398455</span> · VW Polo auto</span></div>
    <div class="leg"><span class="t">~15:30</span><span class="d">Arrive Champoussin — reception closes 18:00</span></div>
    <p class="note warn"><b>Counter:</b> CHF 125.03 due (one-way + extra driver — must be present with license). Vignette should be included; decline winter add-ons.</p>
    <p class="note warn"><b>Baggage:</b> LX fare = Economy Light, 8 kg carry-on ONLY. Add checked bags to BOTH refs before the airport or the rope stays in Sicily.</p>
    <div class="btns cool">
      <a href="https://www.flightaware.com/live/flight/SWR1741" target="_blank" rel="noopener">LX1741 STATUS</a>
      <button data-ics="lx1741">+ CAL LX1741</button>
      <span class="fstat" data-f="LX1741" data-d="2026-08-22" title="tap to refresh">LX1741 · standby</span>
      <button data-ics="europcar">+ CAL EUROPCAR</button>
    </div>
  </div>
</details>
</section>

<section class="chapter" id="swiss">
<details class="acc" data-phase="3">
  <summary class="chead"><span class="tag swi-t">AUG 22–29</span> Sector 2 · Champoussin <span class="now-pill" hidden>NOW</span><span class="chev">▼</span></summary>
  <div class="acc-body">
    <dl class="kv">
      <dt>Base</dt><dd><b>Portes du Soleil</b> · 7 nights · 1BR full kitchen</dd>
      <dt>Grid</dt><dd>Route de Champoussin 22, CH-1873</dd>
      <dt>Ref</dt><dd><span class="conf">A1900002356418001</span> (name: William Doeckel)</dd>
      <dt>Comms</dt><dd class="mono">+41 24 477 26 82</dd>
      <dt>Reception</dt><dd>14:00–18:00 daily · Sun 08:00–11:30</dd>
      <dt>Window</dt><dd>In Sat 22 · 16:00 → Out Sat 29 · 10:00</dd>
    </dl>
