};
function renderToday(){
  const now=Date.now(); let tz='America/Los_Angeles';
  if(now>=M[1].t&&now<M[2].t)tz='Europe/Rome'; else if(now>=M[2].t)tz='Europe/Zurich';
  const key=new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  const a=AGENDA[key]; const card=document.getElementById('todayCard');
  if(!a){card.hidden=true;return;}
  card.hidden=false;
  document.getElementById('todayTitle').textContent=a.title;
  document.getElementById('todayRows').innerHTML=a.rows.map(r=>`<div class="row"><span class="t">${r[0]}</span><span class="d">${r[1]}</span></div>`).join('');
}

function tick(){
  const now=Date.now();
  const next=M.find(m=>m.t>now);
  const lbl=document.getElementById('cdLabel'), cd=document.getElementById('cd');
  if(!next){lbl.style.display='none';cd.style.display='none';document.getElementById('cdDone').style.display='block';}
  else{lbl.textContent=next.label;
    let s=Math.floor((next.t-now)/1000);
    const d=Math.floor(s/86400);s-=d*86400;const h=Math.floor(s/3600);s-=h*3600;const m=Math.floor(s/60);s-=m*60;
    cdD.textContent=d;cdH.textContent=String(h).padStart(2,'0');cdM.textContent=String(m).padStart(2,'0');cdS.textContent=String(s).padStart(2,'0');
  }
  const p=Math.max(0,Math.min(1,(now-TRIP_START)/(TRIP_END-TRIP_START)));
  document.getElementById('progFill').style.width=(p*100)+'%';
  let phase=-1;
  if(now>=TRIP_START)phase=M.filter(m=>m.t<=now).slice(-1)[0]?.phase ?? -1;
  document.querySelectorAll('details.acc[data-phase]').forEach(d=>{
    const pill=d.querySelector('.now-pill'); if(pill)pill.hidden=Number(d.dataset.phase)!==phase;
  });
  const f=tz=>new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',timeZone:tz}).format(new Date());
  clkSD.textContent=f('America/Los_Angeles');clkTP.textContent=f('Europe/Rome');clkCH.textContent=f('Europe/Zurich');
}

/* WEATHER + SUN */
const WMO={0:'☀ clear',1:'🌤 fair',2:'⛅ pt cloudy',3:'☁ overcast',45:'🌫 fog',48:'🌫 fog',51:'🌦 drizzle',53:'🌦 drizzle',55:'🌧 drizzle',61:'🌧 rain',63:'🌧 rain',65:'🌧 hvy rain',71:'🌨 snow',73:'🌨 snow',75:'❄ hvy snow',80:'🌦 showers',81:'🌧 showers',82:'⛈ hvy shwrs',95:'⛈ t-storm',96:'⛈ hail',99:'⛈ hail'};
async function wx(lat,lon,tz,el,sunEl){
  try{
    const u=`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min,sunrise,sunset&timezone=${encodeURIComponent(tz)}&forecast_days=1`;
    const r=await fetch(u);const j=await r.json();
    const c=Math.round(j.current.temperature_2m),code=j.current.weather_code;
    const hi=Math.round(j.daily.temperature_2m_max[0]),lo=Math.round(j.daily.temperature_2m_min[0]);
    el.innerHTML=`${WMO[code]||'—'} <span class="hi">${c}°C</span> ${lo}–${hi}°`;
    const sr=j.daily.sunrise[0].slice(11,16),ss=j.daily.sunset[0].slice(11,16);
    sunEl.textContent=`☉ ${sr} — ${ss}`;
  }catch(e){el.textContent='wx offline';}
}
async function fx(){
  try{
    const r=await fetch('https://api.frankfurter.app/latest?from=USD&to=EUR,CHF');const j=await r.json();
    document.getElementById('fxRow').textContent=`$1 = €${j.rates.EUR.toFixed(2)} · CHF ${j.rates.CHF.toFixed(2)}`;
  }catch(e){document.getElementById('fxRow').textContent='rates offline';}
}

/* MAP */
function buildMap(){
  const map=L.map('map',{scrollWheelZoom:false}).setView([43.5,9.5],5);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:17,attribution:'© OpenStreetMap'}).addTo(map);
  const mk=(lat,lon,color,title,body)=>L.circleMarker([lat,lon],{radius:7,color,weight:2,fillColor:color,fillOpacity:.7}).addTo(map).bindPopup(`<b>${title}</b><br>${body}`);
  const SEA=getComputedStyle(document.documentElement).getPropertyValue('--sea').trim();
  const ALP=getComputedStyle(document.documentElement).getPropertyValue('--alp').trim();
  const BLZ=getComputedStyle(document.documentElement).getPropertyValue('--blaze').trim();
  mk(32.7338,-117.1933,BLZ,'SAN','Depart Aug 17 17:15 · Land Aug 29 20:39');
  mk(38.1760,13.0910,BLZ,'PMO Palermo','Land Aug 18 17:20 · Hertz 18:30 · Return Aug 22 07:30');
  mk(38.0175,12.5449,SEA,'Trapani base','Via Spalti 33, 4th fl · Aug 18–22');
  mk(38.1740,12.7350,SEA,'San Vito Lo Capo','Sport + DWS · 40 min');
  mk(38.1120,12.8000,SEA,'Zingaro','DWS + coves · 50 min');
  mk(38.0372,12.5865,SEA,'Erice','Cable car + pastries · 10 min');
  mk(37.9910,12.5030,SEA,'Salt pans','Sunset · 15 min');
  mk(47.4581,8.5555,BLZ,'ZRH Zurich','Land Aug 22 11:45 · Europcar 12:30');
  mk(46.2000,6.8690,ALP,'Champoussin base','Route de Champoussin 22 · Aug 22–29');
  mk(46.1500,7.0000,ALP,'Lac de Salanfe','Trailhead Van d\'en Haut · 45 min · approx');
  mk(46.3450,6.8360,ALP,'Lac de Taney','Trailhead Le Flon · 40 min · approx');
  mk(46.0770,6.9270,ALP,'Emosson Dam','Reservoir + dino tracks · 1 hr');
  mk(46.2830,7.2140,ALP,'Derborence','Landslide valley · 1 hr · approx');
  mk(46.0670,7.7780,ALP,'Täsch','Park + train to Zermatt · 1h45');
  mk(46.2381,6.1080,BLZ,'GVA Geneva','Car drop Aug 29 10:00 · UA8391 12:40');
