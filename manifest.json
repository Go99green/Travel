<script>
/* GATE */
const HASH='d5d5e69ef6f8f3fbb87ffe5ae5df2af6d079d915bd8f7f10b2414a8f554afac0';
async function sha(s){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')}
function unlock(){document.getElementById('gate').style.display='none';document.getElementById('app').style.display='block';boot()}
if(sessionStorage.getItem('travl_ok')==='1')unlock();
document.getElementById('gateForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const v=document.getElementById('pw').value.trim().toLowerCase();
  if(await sha(v)===HASH){sessionStorage.setItem('travl_ok','1');unlock();}
  else{document.getElementById('gateErr').textContent='Negative — check with Keegan.';document.getElementById('pw').select();}
});

/* MILESTONES */
const M=[
 {t:Date.parse('2026-08-18T00:15:00Z'),label:'T-MINUS TO WHEELS UP',phase:0},
 {t:Date.parse('2026-08-18T15:20:00Z'),label:'T-MINUS TO PALERMO TOUCHDOWN',phase:1},
 {t:Date.parse('2026-08-22T07:45:00Z'),label:'T-MINUS TO SWAP DAY · LX1741',phase:2},
 {t:Date.parse('2026-08-22T14:00:00Z'),label:'T-MINUS TO CHAMPOUSSIN CHECK-IN',phase:3},
 {t:Date.parse('2026-08-29T10:40:00Z'),label:'T-MINUS TO EXTRACTION · GVA',phase:4},
 {t:Date.parse('2026-08-30T03:39:00Z'),label:'T-MINUS TO SAN TOUCHDOWN',phase:4}
];
const TRIP_START=M[0].t, TRIP_END=M[5].t;

/* TODAY AGENDA (dates in local trip tz) */
const AGENDA={
 '2026-08-17':{tz:'America/Los_Angeles',title:'Insertion · SAN',rows:[['17:15','UA 8932 departs SAN — be at airport by 14:15']]},
 '2026-08-18':{tz:'Europe/Rome',title:'Arrival · Sicily',rows:[['13:25','Land Munich (connection 1h55)'],['15:20','LH 1916 departs MUC'],['17:20','Land Palermo'],['18:30','Hertz pickup'],['~19:30','Arrive Trapani base']]},
 '2026-08-19':{tz:'Europe/Rome',title:'Sicily · Day 1',rows:[['—','San Vito Lo Capo recon: routes + DWS sectors'],['PM','Town dinner — couscous']]},
 '2026-08-20':{tz:'Europe/Rome',title:'Sicily · Day 2',rows:[['—','Zingaro DWS + swim coves'],['Sunset','Salt pans']]},
