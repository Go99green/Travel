 '2026-08-23':{tz:'Europe/Zurich',title:'Valais · Day 1',rows:[['—','Door-out: Pointe de l\'Au · grab Multi-Pass']]},
 '2026-08-24':{tz:'Europe/Zurich',title:'Valais · Day 2',rows:[['—','Lac de Salanfe (45 min drive)']]},
